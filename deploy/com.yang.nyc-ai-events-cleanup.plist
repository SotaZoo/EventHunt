<?xml version="1.0" encoding="UTF-8"?>
<!-- deploy/com.yang.nyc-ai-events-cleanup.plist
     Nightly retention sweep — delete posted events older than 30 days.
     Install:
       Generate an install copy with RUNTIME_PATH replaced, then copy it to ~/Library/LaunchAgents/.
       launchctl load -w ~/Library/LaunchAgents/com.yang.nyc-ai-events-cleanup.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yang.nyc-ai-events-cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a &amp;&amp; source RUNTIME_PATH/.env.friends-alpha &amp;&amp; export PYTHONSAFEPATH=1 &amp;&amp; set +a &amp;&amp; cd RUNTIME_PATH &amp;&amp; RUNTIME_PATH/.venv/bin/nyc-ai-scout cleanup</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>RUNTIME_PATH/data/cleanup.out.log</string>
  <key>StandardErrorPath</key>
  <string>RUNTIME_PATH/data/cleanup.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
