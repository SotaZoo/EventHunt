# Copy to .env.friends-alpha, fill real values, then chmod 600.

NYC_AI_EVENTS_FRIEND_MODE=1
NYC_AI_EVENTS_PUBLIC_BASE_URL=https://replace-with-approved-https-origin
NYC_AI_EVENTS_SESSION_SECRET=replace-with-output-from-openssl-rand-hex-32
NYC_AI_EVENTS_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
NYC_AI_EVENTS_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
DATABASE_PATH=/path/to/event-hunt/app/data/events.db

# Local cycle/scoring settings.
LLM_SCORING_MODE=codex-cli
CODEX_CLI_PATH=/usr/local/bin/codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
DISCORD_WEBHOOK_URL=replace-with-discord-webhook-if-running-cycle-from-this-env
