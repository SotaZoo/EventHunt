# Copy to your local staging environment file and fill in the settings.

NYC_AI_EVENTS_FRIEND_MODE=
NYC_AI_EVENTS_PUBLIC_BASE_URL=
NYC_AI_EVENTS_SESSION_SECRET=replace-with-new-random-staging-secret
NYC_AI_EVENTS_GOOGLE_CLIENT_ID=
